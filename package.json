{
  "name": "teleprompter-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Lokale teleprompter- en webcam-recorder voor macOS — vlogs, tutorials, presentaties",
  "author": "Teleprompter Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/macdirtycow/teleprompter-studio.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:web": "vite build",
    "build": "vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "build:dmg": "vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.8",
    "@mediapipe/tasks-vision": "^1.2.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.teleprompterstudio.app",
    "productName": "Teleprompter Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dir"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Teleprompter Studio heeft toegang tot je camera nodig om vlogs op te nemen.",
        "NSMicrophoneUsageDescription": "Teleprompter Studio heeft toegang tot je microfoon nodig om audio op te nemen.",
        "NSLocalNetworkUsageDescription": "Alleen voor lokale studio-functionaliteit."
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  }
}
